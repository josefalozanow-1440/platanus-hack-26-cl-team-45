# Kapso (WhatsApp). Leave empty for local dev: outbound messages are logged instead of sent.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# Claude for the copiloto. Leave empty for local dev: it answers with a scripted fallback.
ANTHROPIC_API_KEY=

# Optional GitHub token for /repo-status. Leave empty: the repo is public.
GITHUB_TOKEN=
