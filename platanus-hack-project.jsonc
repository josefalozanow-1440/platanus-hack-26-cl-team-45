{
  // Your project's name, as it will appear on the voting page.
  "project-name": "Audem",

  // Short one-line summary of your project (in Spanish).
  "project-oneliner-spanish": "Encuestas de opinión que se responden con un audio y muestran lo que piensa la gente en un mapa, no en un porcentaje.",

  // Brief description of your project (in Spanish).
  "project-description-spanish": "Encuestas como Cadem o Criteria reducen cada opinión a sí, no o una alternativa cerrada. En Audem la gente responde una pregunta abierta con un audio, como en WhatsApp. Cada respuesta se transcribe y se lee entera: de qué temas habla la persona, qué piensa de cada uno, qué propone y con qué emoción lo dice. Las posturas se agrupan en un mapa en vivo sin categorías fijadas de antemano: salen de lo que dice la gente, y el retrato se vuelve más fino con cada voz que se suma.",

  // Public URL where your project is deployed and running.
  // Must be a valid URL, for example: https://my-project.vercel.app
  // If your project is an app, put the download link here instead
  // (for example, a URL to download an APK).
  "deploy-url": "https://audem.vercel.app"
}
