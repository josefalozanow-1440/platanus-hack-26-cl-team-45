{
  "condicion": "claude_pregunta_jev",
  "modelo_claude": "opus",
  "columnas": {
    "p1_jefatura": {
      "comunicacion": "Claridad, frecuencia y apertura de la comunicación entre la jefatura y la persona: si informa, escucha y se puede conversar con ella.",
      "trato_y_respeto": "Trato personal que da la jefatura: respeto, cordialidad, empatía y confianza en el día a día.",
      "apoyo_y_disponibilidad": "Disposición de la jefatura a ayudar, estar disponible y respaldar a la persona cuando tiene problemas laborales o personales.",
      "retroalimentacion_y_reconocimiento": "Si la jefatura entrega feedback útil sobre el desempeño y reconoce los logros y el esfuerzo.",
      "autonomia_y_control": "Grado de autonomía y confianza que da la jefatura para tomar decisiones, frente a la microgestión o el control excesivo.",
      "desarrollo_profesional": "Cómo la jefatura impulsa el crecimiento de la persona: aprendizaje, oportunidades, nuevos desafíos y carrera."
    },
    "p2_carga": {
      "volumen_carga": "Cuánto trabajo tiene asignado la persona y si le parece que puede hacerlo en su jornada normal.",
      "horario_desconexion": "Si trabaja fuera de horario, los fines de semana o en vacaciones, y si puede desconectarse de verdad (mensajes, correos, llamadas).",
      "flexibilidad": "Cuánta flexibilidad tiene para decidir su horario y su lugar de trabajo (teletrabajo, permisos, ajustes por temas personales).",
      "organizacion_recursos": "Cómo se planifica y reparte el trabajo en el equipo: prioridades, plazos, dotación y herramientas para cumplir.",
      "apoyo_jefatura": "Cómo responde su jefatura a la carga y a sus necesidades personales: si escucha, entiende y ayuda a ajustar.",
      "bienestar_personal": "Cómo afecta el trabajo a su salud física y mental (estrés, cansancio, agotamiento) y al tiempo que le queda para su familia y su vida personal."
    },
    "p3_remuneracion": {
      "nivel_sueldo": "Si el sueldo base se considera justo frente a las funciones, el mercado y el costo de vida.",
      "equidad_interna": "Si la remuneración se percibe equitativa entre compañeros con cargos, responsabilidades o desempeño similares.",
      "reajustes_y_crecimiento": "Cómo se viven los aumentos de sueldo, los reajustes por inflación y las posibilidades de mejorar la renta con el tiempo.",
      "bonos_e_incentivos": "Opinión sobre los bonos, comisiones e incentivos variables: cuánto pagan, qué tan alcanzables son y si los criterios están claros.",
      "beneficios_no_monetarios": "Valoración de beneficios como seguro de salud, alimentación, días libres, flexibilidad o convenios, y si son útiles.",
      "transparencia_y_pago": "Claridad de la comunicación sobre la política de remuneraciones y si los pagos llegan correctos y a tiempo."
    },
    "p4_crecimiento": {
      "claridad_ruta_carrera": "Qué tan claros y conocidos son los caminos de carrera, cargos posibles y requisitos para ascender o moverse dentro de la empresa.",
      "justicia_promociones": "Percepción de transparencia y equidad en cómo se decide quién asciende o accede a nuevas oportunidades.",
      "apoyo_jefatura": "Rol de la jefatura directa en conversar sobre el desarrollo, dar retroalimentación e impulsar el crecimiento de la persona.",
      "capacitacion_aprendizaje": "Acceso a formación, cursos y experiencias que permiten adquirir nuevas habilidades para crecer.",
      "disponibilidad_vacantes": "Existencia real de vacantes, cargos superiores o movilidad interna disponibles, frente a una estructura estancada o contratación externa.",
      "reconocimiento_compensacion": "Relación entre el crecimiento o desempeño y las mejoras de sueldo, beneficios o reconocimiento recibidos."
    },
    "p5_equipo": {
      "relaciones_equipo": "Calidad del trato y la convivencia entre compañeros del propio equipo: confianza, respeto, compañerismo y conflictos interpersonales.",
      "colaboracion_interna": "Cómo trabaja el propio equipo en conjunto: apoyo mutuo, reparto de la carga y disposición a ayudarse en las tareas del día a día.",
      "colaboracion_otras_areas": "Disposición y eficacia de otras áreas para coordinarse, responder solicitudes y trabajar en conjunto con el equipo.",
      "comunicacion_informacion": "Claridad, oportunidad y fluidez con que circula la información, dentro del equipo y entre áreas.",
      "rol_jefatura": "Cómo influye la jefatura directa en el ambiente y la colaboración: liderazgo, mediación de conflictos y articulación con otras áreas.",
      "procesos_coordinacion": "Si los procesos, roles y responsabilidades entre áreas están bien definidos o generan duplicidades, cuellos de botella y fricciones."
    }
  },
