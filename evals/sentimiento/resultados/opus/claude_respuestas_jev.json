{
  "condicion": "claude_respuestas_jev",
  "modelo_claude": "opus",
  "columnas": {
    "p1_jefatura": {
      "comunicacion": "Qué tan bien y a tiempo la jefatura informa los cambios, responde los mensajes y mantiene espacios de reunión con el equipo.",
      "reconocimiento": "Qué tanto la jefatura nota el trabajo bien hecho y lo valora de forma concreta y visible.",
      "autonomia": "Qué tanto la jefatura confía en el criterio de la persona y la deja decidir sin revisar ni aprobar cada cosa.",
      "desarrollo_feedback": "Qué tanto la jefatura apoya el crecimiento profesional con conversaciones sobre desempeño, retroalimentación concreta y apoyo para capacitarse o avanzar."
    },
    "p2_carga": {
      "volumen_carga_trabajo": "Si el volumen de tareas, metas o casos se puede abordar con el tiempo y la dotación disponibles.",
      "horarios_horas_extra": "Si la persona puede salir a su hora, si hay horas extra, si se pagan o compensan y si la llaman fuera de su turno.",
      "flexibilidad_horaria_remota": "Si la persona puede trabajar desde casa o ajustar su horario y sus turnos según lo que necesite en su vida personal.",
      "bienestar_desconexion": "Cómo el trabajo afecta el cansancio, el sueño, el estrés, la salud y la capacidad de desconectarse fuera del horario.",
      "beneficios_politicas_conciliacion": "Si existen, se conocen y se aplican de forma justa las políticas y beneficios formales de la empresa para la vida personal, como días libres, permisos, seguros o sala cuna."
    },
    "p3_remuneracion": {
      "suficiencia_sueldo": "Si el sueldo alcanza para cubrir los gastos del mes (arriendo, dividendo, colegio, cuentas) y permite ahorrar o vivir con holgura.",
      "competitividad_mercado": "Cómo se compara el sueldo con lo que pagan otras empresas por un cargo similar, según ofertas, headhunters o conocidos.",
      "criterios_aumentos": "Claridad y equidad de los criterios para subir el sueldo: bandas salariales, peso de la evaluación de desempeño y diferencias entre personas del mismo cargo.",
      "seguro_aguinaldos": "Valor de los beneficios de salud y monetarios, como el seguro complementario, los aguinaldos de fiestas patrias y navidad y las gift cards.",
      "tiempo_libre": "Valor de los beneficios de tiempo libre, como el día de cumpleaños, los días administrativos y la tarde libre de los viernes.",
      "convenios": "Utilidad de los convenios con terceros, como gimnasio, óptica o caja de compensación."
    },
    "p4_crecimiento": {
      "capacitacion_formal": "Cursos, plataformas de aprendizaje, diplomados y apoyo económico o de tiempo que da la empresa para formarse.",
      "apoyo_jefatura_y_pares": "Cuánto le enseñan, acompañan y orientan su jefatura y sus compañeros en el día a día.",
      "claridad_ruta_de_carrera": "Si existe y se conoce un mapa de cargos con requisitos claros para pasar al siguiente nivel.",
      "transparencia_ascensos": "Si los ascensos se deciden por mérito, con criterios explicados y retroalimentación, o por cercanía o pituto con las jefaturas.",
      "disponibilidad_de_vacantes": "Cuántos cargos se abren para crecer internamente, incluido el estancamiento en el mismo cargo y la contratación de gente externa para puestos superiores.",
      "intencion_de_permanencia": "Si sus oportunidades de crecimiento le hacen querer quedarse en la empresa o buscar trabajo afuera."
    },
    "p5_equipo": {
      "relacion_equipo": "Trato, confianza, respeto, ayuda y buena onda entre los compañeros del propio equipo, incluido cómo reciben e integran a los recién llegados.",
      "colaboracion_otras_areas": "Disposición, rapidez y claridad de responsables cuando hay que pedir algo o coordinarse con otras áreas de la empresa.",
      "manejo_conflictos": "Cómo se tratan los roces y desacuerdos entre personas: si se conversan de frente o se guardan, se escalan a la jefatura o quedan sin resolver.",
      "herramientas_y_reuniones": "Utilidad de los sistemas, canales (Teams, correo, WhatsApp, CRM, SAP, tickets) y reuniones de coordinación para ordenar el trabajo y no perder información."
    }
  },
