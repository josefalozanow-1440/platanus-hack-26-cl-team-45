{
  "condicion": "claude_pregunta_jev",
  "modelo_claude": "sonnet",
  "columnas": {
    "p1_jefatura": {
      "comunicacion": "Calidad de la comunicación con la jefatura: claridad de las instrucciones, disponibilidad para conversar y transparencia al informar.",
      "confianza_trato": "Trato personal y confianza: respeto, cercanía, empatía y honestidad en el día a día con la jefatura.",
      "apoyo_desarrollo": "Apoyo de la jefatura al crecimiento profesional: retroalimentación, aprendizaje, oportunidades y acompañamiento en el trabajo.",
      "reconocimiento": "Reconocimiento y valoración del trabajo por parte de la jefatura: agradecimiento, justicia en la evaluación y visibilidad de logros.",
      "autonomia_exigencia": "Forma de dirigir el trabajo: autonomía que otorga, carga y exigencias que impone, y grado de control o microgestión.",
      "liderazgo_decisiones": "Capacidad de liderazgo de la jefatura: toma de decisiones, coherencia, manejo de conflictos y equidad con el equipo."
    },
    "p2_carga": {
      "volumen_carga": "Cantidad de trabajo asignado y si es razonable o excesivo para la capacidad del trabajador y los plazos disponibles.",
      "horarios_jornada": "Cumplimiento de la jornada laboral, horas extra, trabajo fuera de horario y flexibilidad de horarios o teletrabajo.",
      "vida_personal": "Tiempo y energía que queda para familia, descanso, salud y actividades personales fuera del trabajo.",
      "estres_bienestar": "Nivel de estrés, cansancio, agotamiento o tranquilidad emocional que le genera el trabajo.",
      "apoyo_jefatura": "Cómo la jefatura y la empresa gestionan, reparten y escuchan la carga de trabajo, y si facilitan el equilibrio.",
      "distribucion_equipo": "Justicia en el reparto del trabajo entre compañeros, dotación suficiente del equipo y colaboración para cubrir tareas."
    },
    "p3_remuneracion": {
      "nivel_salarial": "Si el sueldo base es suficiente y acorde al costo de vida, al mercado y al trabajo que la persona realiza.",
      "equidad_y_reajustes": "Si los sueldos son justos entre personas y cargos, y si los aumentos, ascensos y bonos por desempeño se otorgan de forma transparente y con regularidad.",
      "beneficios_salud_y_bienestar": "Opinión sobre los beneficios de salud y bienestar, como seguro complementario, apoyo en salud mental, convenios y actividades de bienestar.",
      "beneficios_economicos_y_cotidianos": "Opinión sobre los beneficios económicos y cotidianos, como bonos, aguinaldos, alimentación, transporte, préstamos o ayudas familiares.",
      "tiempo_y_flexibilidad": "Opinión sobre los beneficios de tiempo, como días libres adicionales, vacaciones, horarios flexibles y teletrabajo.",
      "comunicacion_y_claridad": "Si la empresa explica con claridad cómo se calcula la remuneración y qué beneficios existen, y cómo se accede a ellos."
    },
    "p4_crecimiento": {
      "claridad_ruta_carrera": "Qué tan definido y conocido es el camino de crecimiento o plan de carrera: qué cargos siguen, qué se necesita para llegar a ellos.",
      "promociones_ascensos": "Percepción sobre la existencia de ascensos o cambios de cargo disponibles y si se otorgan de forma justa y transparente.",
      "capacitacion_desarrollo": "Acceso a capacitaciones, cursos, mentorías y oportunidades de aprender nuevas habilidades.",
      "rol_jefatura": "Apoyo, feedback y conversaciones de desarrollo que da el jefe directo o la jefatura sobre el crecimiento de la persona.",
      "comunicacion_vacantes": "Qué tan bien comunica la empresa las vacantes, procesos de selección interna y oportunidades de movimiento entre áreas.",
      "reconocimiento_remuneracion": "Percepción de que el esfuerzo y el desempeño se reconocen con mayores responsabilidades, aumentos de sueldo o beneficios."
    },
    "p5_equipo": {
      "clima_equipo": "Ambiente humano dentro del equipo directo: confianza, respeto, compañerismo y trato cotidiano entre compañeros.",
      "colaboracion_entre_areas": "Coordinación y disposición a colaborar con otras áreas o departamentos, incluyendo silos, traspasos y ayuda mutua.",
      "comunicacion": "Claridad, oportunidad y fluidez con que se comparte información y se conversa dentro del equipo y con otras áreas.",
      "liderazgo_jefatura": "Rol de la jefatura o líder en fomentar el buen ambiente, resolver conflictos y facilitar el trabajo conjunto.",
      "carga_y_organizacion": "Reparto de tareas, carga de trabajo, procesos y recursos que facilitan o dificultan trabajar bien en conjunto."
    }
  },
