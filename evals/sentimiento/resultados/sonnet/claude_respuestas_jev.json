{
  "condicion": "claude_respuestas_jev",
  "modelo_claude": "sonnet",
  "columnas": {
    "p1_jefatura": {
      "comunicacion_informacion": "Qué tan oportuna, clara y fluida es la comunicación de la jefatura: responde mensajes, avisa cambios a tiempo y mantiene reuniones de equipo.",
      "reconocimiento": "Si la jefatura nota, agradece y valora públicamente o en privado el trabajo bien hecho y el esfuerzo del equipo.",
      "autonomia_confianza": "Cuánta libertad y confianza da la jefatura para decidir y trabajar sin supervisión excesiva, o si controla y revisa todo.",
      "desarrollo_profesional": "Si la jefatura da feedback sobre el desempeño, conversa de crecimiento y apoya la formación y las oportunidades de carrera.",
      "trato_personal": "Cómo es el trato cotidiano de la jefatura hacia la persona: respeto, cercanía, amabilidad y calidad humana de la relación."
    },
    "p2_carga": {
      "volumen_carga_trabajo": "Cantidad de trabajo asignado frente al tiempo y la dotación disponibles, incluidas las metas, la dotación del equipo y los picos de demanda.",
      "horarios_horas_extra": "Cumplimiento del horario de salida, horas extra (registradas o no) y llamados o requerimientos fuera de la jornada.",
      "flexibilidad_permisos": "Facilidad para trabajar de forma remota, ajustar turnos o pedir permisos para asuntos personales, familiares o médicos.",
      "beneficios_vida_personal": "Existencia y utilidad de beneficios concretos para la vida personal, como días libres, bonos, convenios y seguros.",
      "bienestar_salud": "Cómo afectan el trabajo y su carga al cansancio, el sueño, el estrés, el ánimo y la capacidad de desconectarse.",
      "apoyo_jefatura_politicas": "Trato de la jefatura y de la empresa hacia las necesidades personales: si hay reglas claras y apoyo, o si todo depende de la buena voluntad del supervisor."
    },
    "p3_remuneracion": {
      "suficiencia_sueldo": "Si el sueldo base alcanza para cubrir los gastos mensuales, llegar a fin de mes y poder ahorrar.",
      "competitividad_mercado": "Cómo se compara el sueldo con lo que pagan otras empresas o plantas del sector por el mismo cargo, incluyendo ofertas externas y salidas de colegas.",
      "transparencia_aumentos": "Claridad, criterios y justicia de los aumentos y la progresión salarial: bandas, evaluación de desempeño y explicaciones de la jefatura.",
      "beneficios_salud_economicos": "Valoración de los beneficios económicos y de salud: seguro complementario, aguinaldos, gift cards y convenios con comercios o cajas.",
      "tiempo_libre_beneficios": "Valoración de los días y horas libres otorgados como beneficio: cumpleaños, tardes libres en verano y días administrativos."
    },
    "p4_crecimiento": {
      "claridad_ruta_carrera": "Qué tan claro es el camino de crecimiento: existencia de niveles o mapa de cargos, requisitos conocidos y respuestas concretas sobre qué sigue para la persona.",
      "justicia_transparencia_ascensos": "Si los ascensos y selecciones para cargos se deciden de forma justa, por mérito y explicada, o por amistad con jefaturas, sin retroalimentación ni criterios claros.",
      "oportunidades_disponibles": "Cantidad real de cupos y movimientos disponibles para subir de cargo, incluyendo estancamiento en el mismo puesto, vacantes escasas o cargos llenados desde afuera.",
      "capacitacion_formacion": "Acceso, calidad y financiamiento de cursos, plataformas online, diplomados y permisos para estudiar que ofrece la empresa.",
      "apoyo_jefatura_y_equipo": "Apoyo cotidiano de la jefatura directa y compañeros senior: enseñanza, paciencia, disponibilidad y conversaciones periódicas sobre aprendizaje y desarrollo.",
      "retencion_y_permanencia": "Si la persona o sus colegas se quedan o se quieren ir de la empresa por las posibilidades de crecer, y si la empresa valora a quienes llevan tiempo."
    },
    "p5_equipo": {
      "clima_equipo_cercano": "Calidad del trato, la confianza y el compañerismo dentro del equipo directo, incluida la ayuda mutua y la inclusión de los más nuevos.",
      "coordinacion_otras_areas": "Rapidez, claridad de responsabilidades y disposición de otras áreas para responder y cumplir lo que el equipo les pide.",
      "manejo_conflictos": "Cómo se enfrentan los roces entre personas: si se conversan de frente o se callan, se escalan a la jefatura o se resuelven.",
      "herramientas_comunicacion": "Utilidad de las herramientas y canales de trabajo (Teams, correo, WhatsApp, tickets, apps, planillas) para compartir información y coordinarse.",
      "reuniones_coordinacion": "Utilidad, duración y formato de las reuniones periódicas de coordinación (por ejemplo, la reunión de los lunes).",
      "rol_jefatura": "Cómo actúa la jefatura ante problemas del equipo o entre áreas: si los resuelve, los deriva o los deja enfriarse."
    }
  },
