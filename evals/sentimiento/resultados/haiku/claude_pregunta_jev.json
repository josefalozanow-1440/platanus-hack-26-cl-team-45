{
  "condicion": "claude_pregunta_jev",
  "modelo_claude": "haiku",
  "columnas": {
    "p1_jefatura": {
      "comunicacion_y_escucha": "Menciona cómo la jefatura comunica información, expectativas y cambios, y si escucha y está disponible para conversar.",
      "retroalimentacion_y_desarrollo": "Menciona si la jefatura da retroalimentación sobre el desempeño, reconoce los logros y apoya el crecimiento profesional de la persona.",
      "trato_y_respeto": "Menciona la forma en que la jefatura trata a la persona en el día a día, con respeto, empatía, cercanía o, por el contrario, con malos tratos o presión.",
      "autonomia_y_apoyo_operativo": "Menciona si la jefatura delega, otorga autonomía para decidir y provee recursos o ayuda para resolver los problemas del trabajo diario.",
      "equidad_en_decisiones": "Menciona si la jefatura toma decisiones imparciales, reparte tareas y oportunidades de forma justa, o si muestra favoritismos hacia parte del equipo."
    },
    "p2_carga": {
      "carga_trabajo": "Opinión sobre la cantidad de tareas asignadas, la presión por plazos y el cumplimiento de objetivos.",
      "horas_desconexion": "Opinión sobre las horas trabajadas más allá de la jornada, la disponibilidad fuera de horario y la dificultad para desconectarse.",
      "flexibilidad_horario": "Opinión sobre la posibilidad de ajustar horario, modalidad o teletrabajo para organizar el tiempo según necesidades personales.",
      "apoyo_recursos": "Opinión sobre la suficiencia de personal y recursos, y sobre el respaldo de la jefatura para repartir la carga.",
      "impacto_vida_personal": "Opinión sobre cómo el trabajo afecta la vida familiar, la salud, el descanso y el tiempo libre de la persona."
    },
    "p3_remuneracion": {
      "salario_base": "Opinión sobre el sueldo fijo o salario base recibido, su nivel frente al trabajo realizado o al mercado, y los aumentos de sueldo.",
      "bonos_incentivos": "Opinión sobre los bonos variables, comisiones, premios o incentivos por desempeño, incluyendo su monto, frecuencia y condiciones para obtenerlos.",
      "beneficios_salud_bienestar": "Opinión sobre los beneficios de salud y bienestar como seguro médico o dental, seguro de vida, apoyo en salud mental, gimnasio o similares.",
      "vacaciones_dias_libres": "Opinión sobre los días de vacaciones, permisos, días libres adicionales y horarios flexibles como parte de la compensación.",
      "equidad_transparencia": "Opinión sobre si la remuneración es justa y transparente, incluyendo la claridad de los criterios de cálculo y la comparación con compañeros de igual cargo."
    },
    "p4_crecimiento": {
      "rutas_de_carrera": "Menciona si la persona conoce los niveles, cargos o pasos de progresión que existen en la empresa y si sabe qué camino seguir para crecer.",
      "criterios_de_promocion": "Habla de cómo se deciden los ascensos o promociones, incluyendo la transparencia, la objetividad y la equidad de esos criterios y procesos.",
      "formacion_y_desarrollo": "Se refiere al acceso a capacitaciones, cursos, mentorías o proyectos que le permitan adquirir nuevas habilidades para crecer.",
      "retroalimentacion_con_jefatura": "Opina sobre la frecuencia y calidad de las conversaciones con su jefatura o líder sobre su desempeño, metas y desarrollo profesional.",
      "movilidad_interna": "Habla de la posibilidad real de cambiar de área, equipo o rol dentro de la empresa como vía de crecimiento, sin contar la progresión vertical."
    },
    "p5_equipo": {
      "ambiente_general": "Sensación global del clima en el día a día (tranquilidad, buen humor, tensión o estrés), sin atribuirlo a un grupo concreto de personas.",
      "relacion_equipo": "Trato, confianza, respeto y compañerismo entre los miembros del propio equipo.",
      "colaboracion_otras_areas": "Coordinación, apoyo y fluidez del trabajo con personas de otras áreas de la empresa."
    }
  },
