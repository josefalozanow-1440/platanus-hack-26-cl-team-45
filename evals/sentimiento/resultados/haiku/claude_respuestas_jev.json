{
  "condicion": "claude_respuestas_jev",
  "modelo_claude": "haiku",
  "columnas": {
    "p1_jefatura": {
      "comunicacion": "Claridad, oportunidad y disponibilidad con que la jefatura informa sobre cambios, prioridades, metas y decisiones, y responde a consultas.",
      "reconocimiento": "Forma en que la jefatura reconoce, valora y comunica públicamente o en privado los logros y el esfuerzo del trabajo realizado.",
      "desarrollo_profesional": "Apoyo de la jefatura al crecimiento de la persona, incluyendo retroalimentación sobre el desempeño, conversaciones de carrera, oportunidades de aprendizaje y formación.",
      "autonomia": "Grado en que la jefatura delega decisiones y confía en el criterio propio de la persona, evitando la supervisión o revisión excesiva de su trabajo."
    },
    "p2_carga": {
      "carga_trabajo": "Opinión sobre el volumen de trabajo, las metas de casos o despachos y si la dotación de personal alcanza para cubrirlo.",
      "horarios_y_extras": "Opinión sobre el cumplimiento del horario de salida, el registro o pago de horas extra y los llamados o cambios de turno fuera de lo previsto.",
      "flexibilidad_remota": "Opinión sobre la posibilidad de trabajar desde casa o ajustar el horario de trabajo para atender necesidades personales o familiares sin tener que dar explicaciones.",
      "beneficios_vida_personal": "Opinión sobre los beneficios concretos para la vida personal (días libres, permisos, seguros, bonos o salas cuna) y sobre la claridad y consistencia con que la empresa los aplica.",
      "bienestar_personal": "Opinión sobre cómo el trabajo afecta la salud, el descanso, el ánimo y la capacidad de desconectarse fuera de la jornada."
    },
    "p3_remuneracion": {
      "seguro_y_convenios": "Opinión sobre el seguro complementario de salud y los convenios con terceros (gimnasio, óptica, caja de compensación).",
      "aguinaldos_y_dias_libres": "Opinión sobre los aguinaldos, la gift card y los días libres adicionales (cumpleaños, tardes libres, días administrativos).",
      "nivel_del_sueldo": "Opinión sobre si la remuneración base alcanza para vivir y ahorrar, y cómo se compara con el mercado externo y otras empresas.",
      "criterios_de_aumentos": "Opinión sobre la transparencia y claridad de los reajustes salariales, las bandas salariales y los criterios de evaluación de desempeño."
    },
    "p4_crecimiento": {
      "acompanamiento_de_jefatura": "Menciona el apoyo, la paciencia y el tiempo que jefes o compañeros dedican a enseñar, revisar trabajo y resolver dudas del día a día.",
      "formacion_y_cursos": "Menciona la oferta de cursos, plataformas de aprendizaje, financiamiento de estudios o diplomados y la calidad o disponibilidad de la formación.",
      "mapa_de_carrera": "Menciona si existen niveles de cargo, requisitos o una ruta documentada para pasar al siguiente nivel, y si esa ruta está clara o es ambigua.",
      "criterios_de_ascenso": "Menciona cómo se deciden los ascensos y nombramientos (resultados, transparencia, retroalimentación, cupos, favoritismo o relaciones personales)."
    },
    "p5_equipo": {
      "convivencia_equipo": "Trato cotidiano, apoyo mutuo y cohesión dentro del propio equipo de trabajo (cubrirse en turnos, ayudarse con la pega, buen trato entre compañeros).",
      "colaboracion_otras_areas": "Capacidad de otras áreas (comercial, planificación, operaciones, finanzas, mantención) para responder a tiempo, cumplir solicitudes y coordinar prioridades con el equipo.",
      "gestion_roces": "Forma en que se manejan los conflictos y desacuerdos entre personas o áreas (conversar directamente vs. guardarse las cosas, escalar a jefatura o gerencia, resolución o falta de ella).",
      "herramientas_coordinacion": "Utilidad y dispersión de los sistemas y canales de coordinación (TIMS, aplicación CRM, correo, WhatsApp, tickets, reuniones de los lunes y planillas paralelas)."
    }
  },
