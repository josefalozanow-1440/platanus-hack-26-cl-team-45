# Kapso: app.kapso.ai -> API keys.
KAPSO_API_KEY=
# ID del número: `KAPSO_API_KEY=... kapso whatsapp numbers list`. Hoy usamos el sandbox.
KAPSO_PHONE_NUMBER_ID=
# Lo genera crear_webhook.sh; no lo escribas a mano.
KAPSO_WEBHOOK_SECRET=

# Clave de Anthropic (la del proxy de la hackatón sirve, con su ANTHROPIC_BASE_URL).
ANTHROPIC_API_KEY=
